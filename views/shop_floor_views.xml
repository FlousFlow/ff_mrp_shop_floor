<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_shop_floor" model="ir.actions.act_window">
        <field name="name">Shop Floor</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="search_view_id" ref="mrp.view_mrp_production_workorder_form_view_filter"/>
        <field name="domain">[('production_state', 'not in', ('done', 'cancel'))]</field>
        <field name="context">{
            'search_default_ready': True,
            'search_default_progress': True,
            'search_default_blocked': True,
        }</field>
    </record>

    <menuitem id="menu_shop_floor"
              name="Shop Floor"
              action="action_shop_floor"
              web_icon="ff_mrp_shop_floor,static/description/icon.png"
              groups="mrp.group_mrp_user"
              sequence="35"/>
</odoo>
